<Window x:Class="OnkyoMaster.UI.VolumeOsd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onkyo Master" Width="292" Height="84"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="16">
        <Border CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Text="&#xE767;" />
                <ProgressBar x:Name="Bar" Grid.Column="1" Margin="12,0" Height="4" VerticalAlignment="Center" Minimum="0" Maximum="100" />
                <TextBlock x:Name="ValueText" Grid.Column="2" FontSize="16" FontWeight="SemiBold" MinWidth="40"
                           TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
