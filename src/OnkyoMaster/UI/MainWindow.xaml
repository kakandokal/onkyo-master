<Window x:Class="OnkyoMaster.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OnkyoMaster.UI"
        Title="{Binding ModelName, StringFormat='Onkyo Master — {0}', FallbackValue='Onkyo Master'}"
        Width="900" Height="740" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico">
    <!-- DataContext: the Receiver -->
    <Window.Resources>
        <!-- One labelled slider for a LevelControl -->
        <DataTemplate x:Key="LevelRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        Value="{Binding Value}" SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                        ui:SliderPointer.Follow="True" />
                <TextBlock Grid.Column="2" Text="{Binding Text}" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PadButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The status only gets a row of its own when something is wrong. -->
        <Border Margin="16,10,16,0" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>

        <!-- Otherwise it is a dot at the end of the tab strip, with the details in its tooltip. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,24,0" Panel.ZIndex="1" Background="Transparent" ToolTip="{Binding Status}">
            <Ellipse Style="{StaticResource StatusDot}" />
            <TextBlock Style="{StaticResource Dim}" Text="{Binding ModelName}" Margin="7,0,0,0" TextWrapping="NoWrap" />
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="12,6,12,12">

            <!-- ============================== Main zone ============================== -->
            <TabItem Header="Главная">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,0" IsEnabled="{Binding IsReady}">
                        <Border Style="{StaticResource Card}">
                            <ui:ZonePanel DataContext="{Binding Main}" />
                        </Border>

                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Режим звучания" />
                                <TextBlock Text="{Binding ListeningModeName}" FontSize="18" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding ModeButtons}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}" Tag="{Binding Code}" Margin="0,0,6,0" MinWidth="84" Click="Mode_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ComboBox MinWidth="240" Margin="10,0,0,0" ItemsSource="{Binding ListeningMode.Options}"
                                              DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding ListeningMode.Value}"
                                              ToolTip="Выбрать режим напрямую" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                           Text="Кнопки перебирают режимы своей группы, как на пульте. Какие режимы доступны, зависит от входного сигнала." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Сигнал" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Dim}" Text="Звук" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="{Binding AudioInfo}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource Dim}" Text="Видео" FontSize="14" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VideoInfo}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Дисплей, таймер, HDMI" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Яркость дисплея" />
                                    <ListBox Grid.Column="1" Style="{StaticResource Segmented}" ItemsSource="{Binding Dimmer.Options}"
                                             DisplayMemberPath="ShortLabel" SelectedValuePath="Code" SelectedValue="{Binding Dimmer.Value}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Таймер сна, минут" Margin="0,8,12,0" />
                                    <ListBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource Segmented}" ItemsSource="{Binding Sleep.Options}"
                                             DisplayMemberPath="ShortLabel" SelectedValuePath="Code" SelectedValue="{Binding Sleep.Value}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Выход HDMI" Margin="0,8,12,0" />
                                    <ListBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource Segmented}" ItemsSource="{Binding HdmiOut.Options}"
                                             DisplayMemberPath="ShortLabel" SelectedValuePath="Code" SelectedValue="{Binding HdmiOut.Value}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Sound ============================== -->
            <TabItem Header="Звук">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,0" IsEnabled="{Binding IsReady}">
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Тембр" />
                                <ContentControl Content="{Binding Bass}" ContentTemplate="{StaticResource LevelRow}" Focusable="False" />
                                <ContentControl Content="{Binding Treble}" ContentTemplate="{StaticResource LevelRow}" Focusable="False" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Уровни каналов" />
                                <ContentControl Content="{Binding CenterLevel}" ContentTemplate="{StaticResource LevelRow}" Focusable="False" />
                                <ContentControl Content="{Binding SubwooferLevel}" ContentTemplate="{StaticResource LevelRow}" Focusable="False" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                           Text="Временная поправка поверх калибровки; ресивер сбрасывает её при переходе в режим ожидания." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Обработка" />
                                <ContentControl Content="{Binding Vocal}" ContentTemplate="{StaticResource LevelRow}" Focusable="False" Margin="0,0,0,6"
                                                Visibility="{Binding HasVocal, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Подчёркивает голоса. Без звукового сигнала и в некоторых режимах ресивер изменение не принимает — тогда регулятор возвращается на место." />
                                <Grid Background="Transparent" HorizontalAlignment="Left" ToolTipService.ShowDuration="30000">
                                    <Grid.ToolTip>
                                        <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                                   Text="Сжимает динамический диапазон: тихое слышнее, громкое тише. Действует только на дорожки Dolby и DTS." />
                                    </Grid.ToolTip>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Late Night (ночной режим)" />
                                    <ListBox Grid.Column="1" Style="{StaticResource Segmented}" ItemsSource="{Binding LateNight.Options}"
                                             DisplayMemberPath="ShortLabel" SelectedValuePath="Code" SelectedValue="{Binding LateNight.Value}" />
                                    <!-- Empty unless the receiver is in a state the switch does not offer. -->
                                    <TextBlock Grid.Column="2" Style="{StaticResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding LateNightNote}" />
                                </Grid>
                                <CheckBox Margin="0,10,0,0" Content="Music Optimizer — восстановление сжатого звука" IsChecked="{Binding MusicOptimizer.Value}" />
                                <CheckBox Margin="0,4,0,0" Content="Cinema Filter — смягчение резких высоких в фильмах" IsChecked="{Binding CinemaFilter.Value}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Zones ============================== -->
            <TabItem Header="Зоны">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,0" IsEnabled="{Binding IsReady}">
                        <Border Style="{StaticResource Card}" Visibility="{Binding Zone2.IsAvailable, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Zone 2" />
                                <ui:ZonePanel DataContext="{Binding Zone2}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Visibility="{Binding Zone3.IsAvailable, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Zone 3" />
                                <ui:ZonePanel DataContext="{Binding Zone3}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Dim}" Margin="4,0"
                                   Text="«Source» означает, что зона повторяет источник основной зоны. Зоны работают независимо от питания основной." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Tuner ============================== -->
            <TabItem Header="Тюнер">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,0" IsEnabled="{Binding IsReady}">
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Text="{Binding TunerText}" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Dim}" Text="{Binding PresetText}" Margin="0,2,0,12" />
                                <WrapPanel>
                                    <Button Style="{StaticResource RowButton}" Content="FM" Tag="SLI24" Click="Command_Click" MinWidth="64" />
                                    <Button Style="{StaticResource RowButton}" Content="DAB" Tag="SLI33" Click="Command_Click" MinWidth="64" Margin="0,0,18,6" />
                                    <Button Style="{StaticResource RowButton}" Content="◀  Частота" Tag="TUNDOWN" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Частота  ▶" Tag="TUNUP" Click="Command_Click" Margin="0,0,18,6" />
                                    <Button Style="{StaticResource RowButton}" Content="◀  Пресет" Tag="PRSDOWN" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Пресет  ▶" Tag="PRSUP" Click="Command_Click" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Label}" Text="Частота FM, МГц" />
                                    <TextBox x:Name="FrequencyBox" Width="110" KeyDown="FrequencyBox_KeyDown" />
                                    <Button Content="Настроить" Margin="8,0,0,0" Click="Tune_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Сохранённые пресеты" />
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Content="{Binding Label}" Tag="{Binding Code}" Click="Preset_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Dim}"
                                           Text="Пресеты сохраняются с пульта ресивера. Список обновляется при подключении." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Network sources ============================== -->
            <TabItem Header="Сеть">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,0" IsEnabled="{Binding IsReady}">
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Источники" />
                                <WrapPanel>
                                    <ItemsControl ItemsSource="{Binding NetServices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}" Content="{Binding Label}" Tag="{Binding Code}" Click="NetService_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="112" Height="112" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Image Source="{Binding NetArt}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding NetTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding NetArtist}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Style="{StaticResource Dim}" Text="{Binding NetAlbum}" />
                                    <TextBlock Style="{StaticResource Dim}" Text="{Binding NetTime}" Margin="0,2,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Tag="NTCTRDN" Click="Command_Click" ToolTip="Предыдущий" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" Tag="NTCPLAY" Click="Command_Click" Margin="4,0,0,0" ToolTip="Пуск" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE769;" Tag="NTCPAUSE" Click="Command_Click" Margin="4,0,0,0" ToolTip="Пауза" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Tag="NTCSTOP" Click="Command_Click" Margin="4,0,0,0" ToolTip="Стоп" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Tag="NTCTRUP" Click="Command_Click" Margin="4,0,0,0" ToolTip="Следующий" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8EE;" Tag="NTCREPEAT" Click="Command_Click" Margin="16,0,0,0" ToolTip="Повтор" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" Tag="NTCRANDOM" Click="Command_Click" Margin="4,0,0,0" ToolTip="Случайный порядок" />
                                        <Button Content="MODE" Tag="NTCMODE" Click="Command_Click" Margin="16,0,0,0" Height="36"
                                                ToolTip="Как кнопка MODE на пульте: показать на экране картинку с ранее выбранного видеовхода, пока звук идёт с NET или Bluetooth. Повторное нажатие возвращает экран воспроизведения." />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Меню источника" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Tag="NTCRETURN" Click="Command_Click" ToolTip="Назад" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE80F;" Tag="NTCTOP" Click="Command_Click" Margin="4,0,0,0" ToolTip="В начало" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Tag="NTCUP" Click="Command_Click" Margin="16,0,0,0" ToolTip="Вверх" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Tag="NTCDOWN" Click="Command_Click" Margin="4,0,0,0" ToolTip="Вниз" />
                                    <Button Content="Выбрать" Tag="NTCSELECT" Click="Command_Click" Margin="4,0,0,0" />
                                    <TextBlock Text="{Binding NetListTitle}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding NetList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="Line" Content="{Binding Text}" Tag="{Binding Index}" Click="NetLine_Click"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Text}" Value="">
                                                    <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCursor}" Value="True">
                                                    <Setter TargetName="Line" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                                           Text="Ресивер показывает по десять строк; листайте кнопками «вверх» и «вниз»." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Remote ============================== -->
            <TabItem Header="Пульт">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,0" IsEnabled="{Binding IsReady}">
                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Экранное меню ресивера" />
                                <StackPanel Orientation="Horizontal">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource PadButton}" Content="&#xE70E;" Tag="OSDUP" Click="Command_Click" />
                                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource PadButton}" Content="&#xE76B;" Tag="OSDLEFT" Click="Command_Click" />
                                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource PadButton}" Content="&#xE8FB;" Tag="OSDENTER" Click="Command_Click" ToolTip="Enter" />
                                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource PadButton}" Content="&#xE76C;" Tag="OSDRIGHT" Click="Command_Click" />
                                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource PadButton}" Content="&#xE70D;" Tag="OSDDOWN" Click="Command_Click" />
                                    </Grid>
                                    <StackPanel Margin="24,3,0,0" Width="170">
                                        <Button Content="Setup" Tag="OSDMENU" Click="Command_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                        <Button Content="Quick Menu" Tag="OSDQUICK" Click="Command_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                        <Button Content="Назад" Tag="OSDEXIT" Click="Command_Click" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0"
                                           Text="Меню открывается на экране телевизора. Через него доступно всё, чего нет на других вкладках: настройка колонок, слоты Dirac Live, назначение входов." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Телевизор (HDMI-CEC)" />
                                <WrapPanel>
                                    <Button Style="{StaticResource RowButton}" Content="Питание" Tag="CTVPOWER" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Вход" Tag="CTVINPUT" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Громкость −" Tag="CTVVLDN" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Громкость +" Tag="CTVVLUP" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Без звука" Tag="CTVMUTE" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Канал −" Tag="CTVCHDN" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Канал +" Tag="CTVCHUP" Click="Command_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" IsEnabled="{Binding Main.Power}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Плеер (HDMI-CEC)" />
                                <WrapPanel>
                                    <Button Style="{StaticResource RowButton}" Content="Питание" Tag="CDVPOWER" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Пуск" Tag="CDVPLAY" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Пауза" Tag="CDVPAUSE" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Стоп" Tag="CDVSTOP" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Назад" Tag="CDVSKIP.R" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Вперёд" Tag="CDVSKIP.F" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Меню" Tag="CDVMENU" Click="Command_Click" />
                                    <Button Style="{StaticResource RowButton}" Content="Главное меню" Tag="CDVTOPMENU" Click="Command_Click" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Dim}"
                                           Text="Работает, если HDMI-CEC включён на ресивере и на самом устройстве." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Console ============================== -->
            <TabItem Header="Консоль">
                <Grid Margin="4,12,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ConsoleBox" FontFamily="Consolas" KeyDown="ConsoleBox_KeyDown" />
                        <Button Grid.Column="1" Content="Отправить" Margin="8,0,0,0" Click="ConsoleSend_Click" />
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{StaticResource Dim}" Margin="0,6,0,8"
                               Text="Любая команда ISCP без префикса «!1», например MVLQSTN (запрос громкости), SLI05 (вход PC), DIMDIM (яркость дисплея по кругу)." />
                    <ListBox x:Name="LogList" Grid.Row="2" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12" />
                </Grid>
            </TabItem>

            <!-- ============================== Hotkeys ============================== -->
            <TabItem Header="Горячие клавиши">
                <ui:HotkeysPage x:Name="HotkeysTab" />
            </TabItem>

            <!-- ============================== Settings ============================== -->
            <TabItem Header="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Подключение" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Адрес ресивера" />
                                    <TextBox x:Name="AddressBox" Grid.Column="1" Width="170" KeyDown="AddressBox_KeyDown" />
                                    <Button Grid.Column="2" Content="Подключить" Margin="8,0,0,0" Click="ConnectAddress_Click" />
                                    <Button x:Name="DiscoverButton" Grid.Column="3" Content="Найти в сети" Margin="8,0,0,0" Click="Discover_Click" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Сетевой интерфейс" Margin="0,10,12,0" />
                                    <ComboBox x:Name="InterfaceBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0" MinWidth="380"
                                              HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Code"
                                              SelectionChanged="Interface_Changed" DropDownOpened="Interface_DropDownOpened" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse Style="{StaticResource StatusDot}" />
                                    <TextBlock Text="{Binding Status}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="780" />
                                </StackPanel>
                                <TextBlock x:Name="DiscoverResult" Style="{StaticResource Dim}" Margin="0,8,0,0" Visibility="Collapsed" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                                           Text="Привязка нужна, когда Windows отправляет пакеты для ресивера не туда — например, его адрес попадает под маршрут VPN. «Авто» работает только через адаптер, который находится в одной подсети с ресивером; конкретный адаптер — только через него. «Не привязывать» оставляет выбор пути Windows — это нужно, если ресивер в другой подсети, за маршрутизатором." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Поведение" />
                                <CheckBox x:Name="AutoStartBox" Content="Запускать вместе с Windows (в трее)" Click="AutoStart_Click" />
                                <CheckBox x:Name="CloseToTrayBox" Content="При закрытии окна сворачивать в трей, а не выходить из приложения" Click="Option_Click" />
                                <CheckBox x:Name="OsdBox" Content="Показывать индикатор громкости на экране" Click="Option_Click" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Шкала громкости" />
                                    <ListBox x:Name="ScaleBox" Grid.Column="1" Style="{StaticResource Segmented}"
                                             DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Scale_Changed" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Предел громкости" Margin="0,10,12,0" />
                                    <Slider x:Name="MaxVolumeSlider" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Minimum="20" Maximum="100"
                                            SmallChange="1" LargeChange="5" VerticalAlignment="Center" ValueChanged="MaxVolume_Changed"
                                            ui:SliderPointer.Follow="True" />
                                    <TextBlock x:Name="MaxVolumeText" Grid.Row="1" Grid.Column="2" Margin="12,10,0,0" VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Шаг громкости" Margin="0,10,12,0" />
                                    <ListBox x:Name="StepBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource Segmented}"
                                             ItemStringFormat="{}{0:0.#}" SelectionChanged="Step_Changed" />
                                </Grid>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                           Text="Шкалу стоит выбрать ту же, что в меню ресивера (Volume Display): по сети эту настройку узнать нельзя. 0 дБ — это 82 по шкале 0–100. Выше предела приложение громкость не поднимет ни ползунком, ни клавишами; пульт и ручка на ресивере работают как обычно." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Быстрая панель" />
                                <ListBox x:Name="FlyoutItemsBox" Style="{StaticResource ChipList}" SelectionMode="Multiple" Margin="0,0,0,-6"
                                         DisplayMemberPath="Label" SelectionChanged="FlyoutItems_Changed" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                           Text="Что показывать на панели, которая открывается щелчком по значку в трее. Питание, громкость и «без звука» есть на ней всегда." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Вместе с компьютером" />
                                <CheckBox x:Name="PowerOnBox" Content="Включать ресивер, когда компьютер выходит из сна" Click="Option_Click" />
                                <CheckBox x:Name="StandbyBox" Content="Выключать ресивер, когда компьютер засыпает или завершает работу" Click="Option_Click" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Label}" Text="Вход, к которому подключён ПК" />
                                    <ComboBox x:Name="PcInputBox" MinWidth="200" DisplayMemberPath="Label" SelectedValuePath="Code"
                                              SelectionChanged="PcInput_Changed" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                           Text="Если вход указан, при включении ресивер переключается на него, а выключается только когда активен именно он — чтобы не оборвать кино с другого источника." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Сцены" />
                                <ItemsControl x:Name="ScenesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Dim}" Text="{Binding Summary}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Применить" Tag="{Binding}" Margin="8,0,0,0" Click="ApplyScene_Click" />
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" Tag="{Binding}" Margin="8,0,0,0"
                                                        ToolTip="Удалить сцену" Click="DeleteScene_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="SceneNameBox" Width="220" KeyDown="SceneNameBox_KeyDown" />
                                    <Button Content="Сохранить текущее состояние как сцену" Margin="8,0,0,0" Click="SaveScene_Click" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                           Text="Сцена запоминает вход, громкость и режим звучания основной зоны. Применение включает ресивер, если он выключен. Сцены доступны из быстрой панели и меню в трее; сочетание клавиш для сцены назначается на вкладке «Горячие клавиши»." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
